{
  "name": "@fieldboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-all.ts",
    "data:init": "tsx src/data/bootstrap.ts",
    "data:backfill-summaries": "tsx src/data/backfill-summaries.ts",
    "data:load-tlc-yellow": "tsx src/data/load-tlc-yellow.ts",
    "data:load-fashion-catalog": "tsx src/data/load-fashion-catalog.ts",
    "data:ensure-warehouse": "tsx src/data/ensure-warehouse.ts",
    "content:init": "tsx src/content/bootstrap.ts",
    "content:index": "tsx src/content/indexer.ts",
    "content:bootstrap": "tsx src/content/bootstrap.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cline/sdk": "^0.0.75",
    "@duckdb/node-api": "^1.4.1-r.1",
    "@fieldboard/contracts": "0.1.0",
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.6",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
