# The api and content-indexer containers run as this uid/gid so dashboards they
# publish into fieldboard_content stay owned by you. `make` fills these in from
# `id -u`/`id -g`; set them here only if you run `docker compose` directly and
# your host account is not uid 1000.
FIELDBOARD_UID=1000
FIELDBOARD_GID=1000
POSTGRES_DB=fieldboard
POSTGRES_USER=fieldboard
POSTGRES_PASSWORD=fieldboard
DATABASE_URL=postgresql://fieldboard:fieldboard@localhost:5432/fieldboard
WAREHOUSE_DIR=./data/warehouse
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=analytics
MINIO_USE_SSL=false
# demo runs a deterministic local agent. cline calls OpenRouter with one agent.
# crew runs four roles: a planner, then an analyst and a designer in parallel, then a reviewer.
AGENT_MODE=crew
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOKENS_PER_TURN=8192
AGENT_MAX_COST_USD=1
# Demo finishes quickly. Cline against the TLC grain needs a longer run budget.
AGENT_RUN_TIMEOUT_MS=900000

# Crew mode only. Four roles share one deadline and one cost ceiling, so the ceiling is higher
# than AGENT_MAX_COST_USD. An empty per-role model falls back to OPENROUTER_MODEL; the reviewer
# is the role most worth pointing at a stronger model. Only the analyst and reviewer may query.
CREW_MAX_COST_USD=4
CREW_PLANNER_MODEL=
CREW_ANALYSIS_MODEL=
CREW_LAYOUT_MODEL=
CREW_REVIEWER_MODEL=
CREW_ANALYSIS_QUERY_BUDGET=20
CREW_REVIEW_QUERY_BUDGET=4

API_PORT=3000
WEB_PORT=5173
# Maximum allowed by the API. TLC aggregations need this ceiling; 20s is too short.
QUERY_TIMEOUT_MS=120000
QUERY_MAX_ROWS=500
QUERY_MAX_BYTES=2097152
DUCKDB_EXTENSION_DIRECTORY=.duckdb/extensions

# Host path for the dedicated Git-canonical authored-content repository.
FIELDBOARD_CONTENT_PATH=./fieldboard_content
# Direct Node development uses this path; Docker overrides it to /content.
CONTENT_REPOSITORY_PATH=./fieldboard_content
CONTENT_GIT_BRANCH=main
CONTENT_GIT_AUTHOR_NAME=Fieldboard
CONTENT_GIT_AUTHOR_EMAIL=fieldboard@local
CONTENT_REPOSITORY_ENABLED=true
# Optional poll interval for the content-indexer sidecar (milliseconds).
# CONTENT_INDEX_INTERVAL_MS=3000

# Optional one-time grain copies into data/warehouse/*.duckdb
# Fashion defaults to the public Hugging Face fashion-dataset CSV.
# FASHION_CATALOG_URL=https://huggingface.co/datasets/nreimers/fashion-dataset/resolve/main/train.csv
# FASHION_CATALOG_FILE=./data/raw/fashion-train.csv
# TLC_SOURCE_DATABASE_URL is unused; TLC loads official monthly Parquet.
